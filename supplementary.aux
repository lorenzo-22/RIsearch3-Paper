\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces  \textbf  {Output-compression modes within RIsearch}: zstd versus gzip (32 threads, extension 20\,nt). Numbers above bars give zstd time relative to gzip. On seed-and-extend workloads zstd trims up to ${\sim }39\%$ of wall-clock time (relative time $0.61$--$0.94$) because compression, not search, is accelerated; on sub-second singleton-seed runs, where output is tiny, zstd can be marginally slower (up to $1.24$). RIsearch2 offers only gzip-style output, so the head-to-head comparisons in \cref  {fig:risearch-comparison} use gzip for both tools; with zstd, RIsearch's advantage over RIsearch2 widens further (\cref  {fig:risearch-scaling}). }}{S6}{figure.4}\protected@file@percent }
\newlabel{fig:risearch-compression}{{S4}{S6}{\textbf {Output-compression modes within RIsearch}: zstd versus gzip (32 threads, extension 20\,nt). Numbers above bars give zstd time relative to gzip. On seed-and-extend workloads zstd trims up to ${\sim }39\%$ of wall-clock time (relative time $0.61$--$0.94$) because compression, not search, is accelerated; on sub-second singleton-seed runs, where output is tiny, zstd can be marginally slower (up to $1.24$). RIsearch2 offers only gzip-style output, so the head-to-head comparisons in \cref {fig:risearch-comparison} use gzip for both tools; with zstd, RIsearch's advantage over RIsearch2 widens further (\cref {fig:risearch-scaling})}{figure.4}{}}
\newlabel{fig:risearch-compression@cref}{{[figure][4][]S4}{[S1][2][]S6}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {S2.4}Genome indexing and RIsearch2 binding-site search}{S6}{subsection.2.4}\protected@file@percent }
\newlabel{sec:genome-indexing}{{S2.4}{S6}{Genome indexing and RIsearch2 binding-site search}{subsection.2.4}{}}
\newlabel{sec:genome-indexing@cref}{{[subsection][4][2]S2.4}{[S1][6][]S6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces  \textbf  {Suffix-array index construction time for the GRCh38/hg38 genome:} RIsearch2 (C, single-threaded) versus RIsearch (Rust) at 1, 8 and 16 threads, each with and without writing the index to disk. Numbers above bars give the time relative to the corresponding RIsearch2 baseline (lower is faster). Writing to disk, RIsearch builds the index ${\sim }2.2\times $ faster at 16 threads ($0.45\times $); kept in memory, its parallel construction is up to ${\sim }5.6\times $ faster ($0.18\times $), indicating that disk I/O dominates the write-to-disk timing. }}{S7}{figure.5}\protected@file@percent }
\newlabel{fig:indexing}{{S5}{S7}{\textbf {Suffix-array index construction time for the GRCh38/hg38 genome:} RIsearch2 (C, single-threaded) versus RIsearch (Rust) at 1, 8 and 16 threads, each with and without writing the index to disk. Numbers above bars give the time relative to the corresponding RIsearch2 baseline (lower is faster). Writing to disk, RIsearch builds the index ${\sim }2.2\times $ faster at 16 threads ($0.45\times $); kept in memory, its parallel construction is up to ${\sim }5.6\times $ faster ($0.18\times $), indicating that disk I/O dominates the write-to-disk timing}{figure.5}{}}
\newlabel{fig:indexing@cref}{{[figure][5][]S5}{[S1][2][]S7}{}{}{}}
