\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces  \textbf  {Full-genome accessibility pre-computation: legacy script versus siOFF's \texttt  {accessibility} subcommand} (hg38, $W{=}80$, $L{=}40$, $u{=}30$, 64 workers). \textbf  {Left:}~wall-clock time: siOFF folds the whole genome in 8.85\,h versus 12.0\,h for the legacy \texttt  {RNAplfold} script ($-26\%$). \textbf  {Centre:}~peak resident memory: 3.78\,GB versus 324\,MB for the legacy script (roughly $12\times $ higher, but small relative to server memory). \textbf  {Right:}~total on-disk profile size across all chromosomes: 111.8\,GB versus 192.6\,GB ($-42\%$), because each chromosome is stored as a single compressed two-strand Parquet file rather than two uncompressed binary files. Values are also given in \cref  {tab:acc-bench}. }}{S9}{figure.7}\protected@file@percent }
\newlabel{fig:accessibility}{{S7}{S9}{\textbf {Full-genome accessibility pre-computation: legacy script versus siOFF's \texttt {accessibility} subcommand} (hg38, $W{=}80$, $L{=}40$, $u{=}30$, 64 workers). \textbf {Left:}~wall-clock time: siOFF folds the whole genome in 8.85\,h versus 12.0\,h for the legacy \texttt {RNAplfold} script ($-26\%$). \textbf {Centre:}~peak resident memory: 3.78\,GB versus 324\,MB for the legacy script (roughly $12\times $ higher, but small relative to server memory). \textbf {Right:}~total on-disk profile size across all chromosomes: 111.8\,GB versus 192.6\,GB ($-42\%$), because each chromosome is stored as a single compressed two-strand Parquet file rather than two uncompressed binary files. Values are also given in \cref {tab:acc-bench}}{figure.7}{}}
\newlabel{fig:accessibility@cref}{{[figure][7][]S7}{[S1][3][]S9}{}{}{}}
