\citation{huesken2005design}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces  \textbf  {Output-compression modes within RIsearch}: zstd versus gzip (32 threads, extension 20\,nt). Numbers above bars give zstd time relative to gzip. On seed-and-extend workloads zstd trims up to ${\sim }39\%$ of wall-clock time (relative time $0.61$--$0.94$) because compression, not search, is accelerated; on sub-second singleton-seed runs, where output is tiny, zstd can be marginally slower (up to $1.05$). RIsearch2 offers only gzip-style output, so the head-to-head comparisons in \cref  {fig:risearch-comparison} use gzip for both tools; with zstd, RIsearch's advantage over RIsearch2 widens further (\cref  {fig:risearch-scaling}). }}{S6}{figure.4}\protected@file@percent }
\newlabel{fig:risearch-compression}{{S4}{S6}{\textbf {Output-compression modes within RIsearch}: zstd versus gzip (32 threads, extension 20\,nt). Numbers above bars give zstd time relative to gzip. On seed-and-extend workloads zstd trims up to ${\sim }39\%$ of wall-clock time (relative time $0.61$--$0.94$) because compression, not search, is accelerated; on sub-second singleton-seed runs, where output is tiny, zstd can be marginally slower (up to $1.05$). RIsearch2 offers only gzip-style output, so the head-to-head comparisons in \cref {fig:risearch-comparison} use gzip for both tools; with zstd, RIsearch's advantage over RIsearch2 widens further (\cref {fig:risearch-scaling})}{figure.4}{}}
\newlabel{fig:risearch-compression@cref}{{[figure][4][]S4}{[S1][2][]S6}}
