\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces  \textbf  {Full-genome accessibility pre-computation: legacy script versus siOFF's \texttt  {accessibility} subcommand} (hg38, $W{=}80$, $L{=}40$, $u{=}30$, 64 workers). \textbf  {Left:}\nobreakspace  {}wall-clock time: siOFF folds the whole genome in 9.38\,h versus 11.85\,h for the legacy \texttt  {RNAplfold} script ($-21\%$). \textbf  {Centre:}\nobreakspace  {}peak memory, measured as the proportional set size (PSS) summed over all processes and sampled every 0.5\,s: 147\,GB versus 18.5\,GB for the legacy script. \textbf  {Right:}\nobreakspace  {}total on-disk profile size across all chromosomes: 192.6\,GB for both, as both store one byte per position and unpaired-region length. Values are also given in \cref  {tab:acc-bench}. }}{S9}{figure.7}\protected@file@percent }
\newlabel{fig:accessibility}{{S7}{S9}{\textbf {Full-genome accessibility pre-computation: legacy script versus siOFF's \texttt {accessibility} subcommand} (hg38, $W{=}80$, $L{=}40$, $u{=}30$, 64 workers). \textbf {Left:}~wall-clock time: siOFF folds the whole genome in 9.38\,h versus 11.85\,h for the legacy \texttt {RNAplfold} script ($-21\%$). \textbf {Centre:}~peak memory, measured as the proportional set size (PSS) summed over all processes and sampled every 0.5\,s: 147\,GB versus 18.5\,GB for the legacy script. \textbf {Right:}~total on-disk profile size across all chromosomes: 192.6\,GB for both, as both store one byte per position and unpaired-region length. Values are also given in \cref {tab:acc-bench}}{figure.7}{}}
\newlabel{fig:accessibility@cref}{{[figure][7][]S7}{[S1][3][]S9}}
