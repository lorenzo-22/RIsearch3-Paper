\citation{huesken2005design}
\citation{huesken2005design}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Suffix-array index construction time for the GRCh38/hg38 genome:} RIsearch2 (C, single-threaded) versus RIsearch (Rust) at 1, 8 and 16 threads, each with and without writing the index to disk. Numbers above bars give the time relative to the corresponding RIsearch2 baseline (lower is faster). Writing to disk, RIsearch builds the index ${\sim }2.2\times $ faster at 16 threads ($0.45\times $); kept in memory, its parallel construction is up to ${\sim }5.6\times $ faster ($0.18\times $), indicating that disk I/O dominates the write-to-disk timing.}}{S7}{figure.6}\protected@file@percent }
\newlabel{fig:indexing}{{S6}{S7}{\textbf {Suffix-array index construction time for the GRCh38/hg38 genome:} RIsearch2 (C, single-threaded) versus RIsearch (Rust) at 1, 8 and 16 threads, each with and without writing the index to disk. Numbers above bars give the time relative to the corresponding RIsearch2 baseline (lower is faster). Writing to disk, RIsearch builds the index ${\sim }2.2\times $ faster at 16 threads ($0.45\times $); kept in memory, its parallel construction is up to ${\sim }5.6\times $ faster ($0.18\times $), indicating that disk I/O dominates the write-to-disk timing}{figure.6}{}}
\newlabel{fig:indexing@cref}{{[figure][6][]S6}{[S1][2][]S7}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Wall-clock time and peak memory of RIOT versus the legacy pipeline across batch sizes.} Each box spans the interquartile range of five independent randomised trials; the central line marks the median; whiskers extend to the full range. \textbf  {(A)}\nobreakspace  {}Wall-clock time (seconds) for the intersection, accessibility annotation, Boltzmann partition-function, and output stages on 500, 1{,}000, and 2{,}000 siRNAs from the Hüsken et\nobreakspace  {}al.\ genome-wide efficacy library\nobreakspace  {}\citep  {huesken2005design}. RIOT achieves a $7.7{-}10.7\times $ speed-up relative to the legacy Python\nobreakspace  {}2.7 implementation. \textbf  {(B)}\nobreakspace  {}Peak resident-set size (GB) of the parent process as reported by \texttt  {/usr/bin/time -v}. RIOT plateaus at $\approx $7\,GB regardless of batch size; the legacy pipeline grows from $\sim $8.5\,GB to $\sim $10\,GB as batch size increases. Benchmarks were run on an AMD EPYC 9554 server (64 physical cores) with 32 workers for both pipelines; pre-computed RIsearch2 binding-site predictions were provided as input so that search time is excluded from both measurements.}}{S8}{figure.7}\protected@file@percent }
\newlabel{fig:pipeline}{{S7}{S8}{\textbf {Wall-clock time and peak memory of RIOT versus the legacy pipeline across batch sizes.} Each box spans the interquartile range of five independent randomised trials; the central line marks the median; whiskers extend to the full range. \textbf {(A)}~Wall-clock time (seconds) for the intersection, accessibility annotation, Boltzmann partition-function, and output stages on 500, 1{,}000, and 2{,}000 siRNAs from the Hüsken et~al.\ genome-wide efficacy library~\citep {huesken2005design}. RIOT achieves a $7.7{-}10.7\times $ speed-up relative to the legacy Python~2.7 implementation. \textbf {(B)}~Peak resident-set size (GB) of the parent process as reported by \texttt {/usr/bin/time -v}. RIOT plateaus at $\approx $7\,GB regardless of batch size; the legacy pipeline grows from $\sim $8.5\,GB to $\sim $10\,GB as batch size increases. Benchmarks were run on an AMD EPYC 9554 server (64 physical cores) with 32 workers for both pipelines; pre-computed RIsearch2 binding-site predictions were provided as input so that search time is excluded from both measurements}{figure.7}{}}
\newlabel{fig:pipeline@cref}{{[figure][7][]S7}{[S1][7][]S8}}
