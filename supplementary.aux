\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces \textbf  {Full-genome accessibility pre-computation: legacy script versus RIOT's \texttt  {accessibility} subcommand} (hg38, $W{=}80$, $L{=}40$, $u{=}30$, 64 workers). \textbf  {(A)}\nobreakspace  {}Wall-clock time: RIOT folds the whole genome in 8\,h\,46\,m versus 13\,h\,12\,m for the legacy \texttt  {RNAplfold} script ($-34\%$). \textbf  {(B)}\nobreakspace  {}Total on-disk profile size across all chromosomes: 111.8\,GB versus 192.6\,GB ($-42\%$), because each chromosome is stored as a single compressed two-strand Parquet file rather than two uncompressed binary files. Peak memory (not shown) is given in \cref  {tab:acc-bench}.}}{S9}{figure.8}\protected@file@percent }
\newlabel{fig:accessibility}{{S8}{S9}{\textbf {Full-genome accessibility pre-computation: legacy script versus RIOT's \texttt {accessibility} subcommand} (hg38, $W{=}80$, $L{=}40$, $u{=}30$, 64 workers). \textbf {(A)}~Wall-clock time: RIOT folds the whole genome in 8\,h\,46\,m versus 13\,h\,12\,m for the legacy \texttt {RNAplfold} script ($-34\%$). \textbf {(B)}~Total on-disk profile size across all chromosomes: 111.8\,GB versus 192.6\,GB ($-42\%$), because each chromosome is stored as a single compressed two-strand Parquet file rather than two uncompressed binary files. Peak memory (not shown) is given in \cref {tab:acc-bench}}{figure.8}{}}
\newlabel{fig:accessibility@cref}{{[figure][8][]S8}{[S1][8][]S9}}
