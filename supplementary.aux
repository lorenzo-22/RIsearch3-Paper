\newlabel{sec:genome-indexing}{{S2.4}{S6}{Genome indexing and RIsearch2 binding-site search}{subsection.2.4}{}}
\newlabel{sec:genome-indexing@cref}{{[subsection][4][2]S2.4}{[S1][6][]S6}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces  \textbf  {Suffix-array index construction time for the masked GRCh38/hg38 genome (3.1\,GB):} RIsearch2 (C, single-threaded) versus RIsearch3 at 1, 8 and 16 threads, with the index written to local disk, to tmpfs (\texttt  {/dev/shm}) or to \texttt  {/dev/null}. Error bars show the standard deviation across Hyperfine runs. Writing to local disk, RIsearch3 builds the index ${\sim }1.9\times $ faster at 16 threads ($0.53\times $ the RIsearch2 time); written to tmpfs, ${\sim }5.4\times $ faster ($0.18\times $); written to \texttt  {/dev/null}, its parallel construction is up to ${\sim }8.0\times $ faster ($0.13\times $), indicating that disk I/O dominates the write-to-disk timing. }}{S7}{figure.5}\protected@file@percent }
\newlabel{fig:indexing}{{S5}{S7}{\textbf {Suffix-array index construction time for the masked GRCh38/hg38 genome (3.1\,GB):} RIsearch2 (C, single-threaded) versus RIsearch3 at 1, 8 and 16 threads, with the index written to local disk, to tmpfs (\texttt {/dev/shm}) or to \texttt {/dev/null}. Error bars show the standard deviation across Hyperfine runs. Writing to local disk, RIsearch3 builds the index ${\sim }1.9\times $ faster at 16 threads ($0.53\times $ the RIsearch2 time); written to tmpfs, ${\sim }5.4\times $ faster ($0.18\times $); written to \texttt {/dev/null}, its parallel construction is up to ${\sim }8.0\times $ faster ($0.13\times $), indicating that disk I/O dominates the write-to-disk timing}{figure.5}{}}
\newlabel{fig:indexing@cref}{{[figure][5][]S5}{[S1][2][]S7}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces  \textbf  {Wall-clock time and peak memory of siOFF versus the legacy pipeline across batch sizes.} Points are the mean of five timed runs; error bars are 95\% confidence intervals (Student's\nobreakspace  {}$t$). \textbf  {(A)}\nobreakspace  {}Wall-clock time (seconds) for the intersection, accessibility annotation, Boltzmann partition-function, and output stages on 500, 1{,}000, and 2{,}000 siRNAs from the Hüsken et\nobreakspace  {}al.\ genome-wide efficacy library\nobreakspace  {}\citep  {huesken2005design}. siOFF achieves a $20.1{-}23.3\times $ speed-up relative to the legacy Python\nobreakspace  {}2.7 implementation. \textbf  {(B)}\nobreakspace  {}Peak memory (GB) of the whole process tree, measured as the summed proportional set size (PSS) of all processes, sampled every 0.5\,s in each timed run. siOFF peaks at 47--52\,GB, the legacy pipeline at 12--17\,GB. Benchmarks were run on an AMD EPYC 9554 server (64 physical cores) with 32 workers for both pipelines; the same pre-computed RIsearch2 binding-site predictions were provided as input so that search time is excluded from both measurements. }}{S8}{figure.6}\protected@file@percent }
\newlabel{fig:pipeline}{{S6}{S8}{\textbf {Wall-clock time and peak memory of siOFF versus the legacy pipeline across batch sizes.} Points are the mean of five timed runs; error bars are 95\% confidence intervals (Student's~$t$). \textbf {(A)}~Wall-clock time (seconds) for the intersection, accessibility annotation, Boltzmann partition-function, and output stages on 500, 1{,}000, and 2{,}000 siRNAs from the Hüsken et~al.\ genome-wide efficacy library~\citep {huesken2005design}. siOFF achieves a $20.1{-}23.3\times $ speed-up relative to the legacy Python~2.7 implementation. \textbf {(B)}~Peak memory (GB) of the whole process tree, measured as the summed proportional set size (PSS) of all processes, sampled every 0.5\,s in each timed run. siOFF peaks at 47--52\,GB, the legacy pipeline at 12--17\,GB. Benchmarks were run on an AMD EPYC 9554 server (64 physical cores) with 32 workers for both pipelines; the same pre-computed RIsearch2 binding-site predictions were provided as input so that search time is excluded from both measurements}{figure.6}{}}
\newlabel{fig:pipeline@cref}{{[figure][6][]S6}{[S1][3][]S8}}
