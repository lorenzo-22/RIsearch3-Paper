\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces  \textbf  {Effect of extension length on search time} (0--20\,nt, 32 threads, matched gzip output). From 5 to 20\,nt, RIsearch's advantage grows with extension length as the Gotoh dynamic-programming stage comes to dominate runtime (geometric-mean time relative to RIsearch2 across the ten seeds: $0.66$ at 5\,nt, $0.56$ at 20\,nt). Extension\nobreakspace  {}0 (seed matching only, energy threshold\nobreakspace  {}0) is a separate regime, in which RIsearch takes $0.48$--$0.78$ of RIsearch2's time (geometric mean $0.59$). }}{S5}{figure.3}\protected@file@percent }
\newlabel{fig:risearch-extension}{{S3}{S5}{\textbf {Effect of extension length on search time} (0--20\,nt, 32 threads, matched gzip output). From 5 to 20\,nt, RIsearch's advantage grows with extension length as the Gotoh dynamic-programming stage comes to dominate runtime (geometric-mean time relative to RIsearch2 across the ten seeds: $0.66$ at 5\,nt, $0.56$ at 20\,nt). Extension~0 (seed matching only, energy threshold~0) is a separate regime, in which RIsearch takes $0.48$--$0.78$ of RIsearch2's time (geometric mean $0.59$)}{figure.3}{}}
\newlabel{fig:risearch-extension@cref}{{[figure][3][]S3}{[S1][2][]S5}}
