\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces  \textbf  {Thread scaling of RIsearch versus RIsearch2} (seed scheme\nobreakspace  {}6, extension lengths 0 and 20\,nt, 1--32 threads). With matched gzip output, RIsearch is faster than RIsearch2 at every thread count in both extension modes, and its zstd output mode widens the gap further (RIsearch2 offers only gzip). From 1 to 32 threads, RIsearch2 speeds up $13.3\times $ (extension\nobreakspace  {}0) and $16.8\times $ (extension\nobreakspace  {}20), RIsearch with gzip output $19.3\times $ and $20.3\times $. }}{S4}{figure.2}\protected@file@percent }
\newlabel{fig:risearch-scaling}{{S2}{S4}{\textbf {Thread scaling of RIsearch versus RIsearch2} (seed scheme~6, extension lengths 0 and 20\,nt, 1--32 threads). With matched gzip output, RIsearch is faster than RIsearch2 at every thread count in both extension modes, and its zstd output mode widens the gap further (RIsearch2 offers only gzip). From 1 to 32 threads, RIsearch2 speeds up $13.3\times $ (extension~0) and $16.8\times $ (extension~20), RIsearch with gzip output $19.3\times $ and $20.3\times $}{figure.2}{}}
\newlabel{fig:risearch-scaling@cref}{{[figure][2][]S2}{[S1][2][]S4}}
