\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces  \textbf  {Per-configuration search time of RIsearch versus RIsearch2.} Wall-clock time at 32 threads with extension length 20\,nt (seed\nobreakspace  {}21 without mismatches: extension 0) and matched gzip-compressed output, across seed schemes, output formats (\texttt  {fmt\_p1}--\texttt  {p3}) and mismatch counts (\texttt  {m1}--\texttt  {m3}). Numbers above each bar pair give RIsearch's time relative to RIsearch2 (lower is faster). On the canonical seed-and-extend schemes RIsearch is roughly twice as fast (relative time $0.42$--$0.68$); the margin narrows for long exact-match singleton seeds (12, 16, 21: $0.58$--$0.68$), whose sub-second runtimes are dominated by fixed start-up rather than by search. }}{S3}{figure.1}\protected@file@percent }
\newlabel{fig:risearch-comparison}{{S1}{S3}{\textbf {Per-configuration search time of RIsearch versus RIsearch2.} Wall-clock time at 32 threads with extension length 20\,nt (seed~21 without mismatches: extension 0) and matched gzip-compressed output, across seed schemes, output formats (\texttt {fmt\_p1}--\texttt {p3}) and mismatch counts (\texttt {m1}--\texttt {m3}). Numbers above each bar pair give RIsearch's time relative to RIsearch2 (lower is faster). On the canonical seed-and-extend schemes RIsearch is roughly twice as fast (relative time $0.42$--$0.68$); the margin narrows for long exact-match singleton seeds (12, 16, 21: $0.58$--$0.68$), whose sub-second runtimes are dominated by fixed start-up rather than by search}{figure.1}{}}
\newlabel{fig:risearch-comparison@cref}{{[figure][1][]S1}{[S1][2][]S3}}
