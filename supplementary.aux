\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Thread scaling of RIsearch output compression} (seed\nobreakspace  {}6, extension 20\,nt): zstd is consistently faster than gzip, e.g.\ 6.7\,s vs.\ 8.3\,s at 32 threads.}}{S6}{figure.5}\protected@file@percent }
\newlabel{fig:risearch-compression-scaling}{{S5}{S6}{\textbf {Thread scaling of RIsearch output compression} (seed~6, extension 20\,nt): zstd is consistently faster than gzip, e.g.\ 6.7\,s vs.\ 8.3\,s at 32 threads}{figure.5}{}}
