\citation{lorenz2011vienna}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Per-configuration search time of RIsearch versus RIsearch2.} Wall-clock time at 32 threads with extension length 20\,nt and matched gzip-compressed output, across seed schemes, output formats (\texttt  {fmt\_p1}--\texttt  {p4}) and mismatch counts (\texttt  {m1}--\texttt  {m3}). Numbers above each bar pair give RIsearch's time relative to RIsearch2 (lower is faster). On the canonical seed-and-extend schemes RIsearch is roughly twice as fast (relative time $0.44$--$0.53$); the margin narrows for long exact-match singleton seeds (12, 16, 21), whose sub-second runtimes are dominated by fixed start-up rather than by search.}}{S2}{figure.1}\protected@file@percent }
\newlabel{fig:risearch-comparison}{{S1}{S2}{\textbf {Per-configuration search time of RIsearch versus RIsearch2.} Wall-clock time at 32 threads with extension length 20\,nt and matched gzip-compressed output, across seed schemes, output formats (\texttt {fmt\_p1}--\texttt {p4}) and mismatch counts (\texttt {m1}--\texttt {m3}). Numbers above each bar pair give RIsearch's time relative to RIsearch2 (lower is faster). On the canonical seed-and-extend schemes RIsearch is roughly twice as fast (relative time $0.44$--$0.53$); the margin narrows for long exact-match singleton seeds (12, 16, 21), whose sub-second runtimes are dominated by fixed start-up rather than by search}{figure.1}{}}
\newlabel{fig:risearch-comparison@cref}{{[figure][1][]S1}{[S1][1][]S2}}
\newlabel{eq:partition}{{1}{S2}{RIOT pipeline stages and partition-function model}{equation.0.1}{}}
\newlabel{eq:partition@cref}{{[equation][1][]1}{[S1][2][]S2}}
\citation{huesken2005design}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Thread scaling of RIsearch versus RIsearch2} (seed scheme\nobreakspace  {}6, extension 20\,nt). RIsearch is faster at every thread count, from $1.7\times $ single-threaded (RIsearch2 188\,s vs.\ RIsearch 110\,s) to $2.1\times $ at 32 threads (17.2\,s vs.\ 8.3\,s). Both tools scale near-linearly up to 16 threads.}}{S3}{figure.2}\protected@file@percent }
\newlabel{fig:risearch-scaling}{{S2}{S3}{\textbf {Thread scaling of RIsearch versus RIsearch2} (seed scheme~6, extension 20\,nt). RIsearch is faster at every thread count, from $1.7\times $ single-threaded (RIsearch2 188\,s vs.\ RIsearch 110\,s) to $2.1\times $ at 32 threads (17.2\,s vs.\ 8.3\,s). Both tools scale near-linearly up to 16 threads}{figure.2}{}}
\newlabel{fig:risearch-scaling@cref}{{[figure][2][]S2}{[S1][1][]S3}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Effect of extension length on search time} (0--20\,nt, 32 threads, matched gzip output). Numbers above bars give RIsearch's time relative to RIsearch2. RIsearch's advantage grows with extension length as the Gotoh dynamic-programming stage comes to dominate runtime; at extension\nobreakspace  {}0 (seed matching only) the two tools are closer.}}{S4}{figure.3}\protected@file@percent }
\newlabel{fig:risearch-extension}{{S3}{S4}{\textbf {Effect of extension length on search time} (0--20\,nt, 32 threads, matched gzip output). Numbers above bars give RIsearch's time relative to RIsearch2. RIsearch's advantage grows with extension length as the Gotoh dynamic-programming stage comes to dominate runtime; at extension~0 (seed matching only) the two tools are closer}{figure.3}{}}
\newlabel{fig:risearch-extension@cref}{{[figure][3][]S3}{[S1][1][]S4}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Output-compression modes within RIsearch}: zstd versus gzip (32 threads, extension 20\,nt). Numbers above bars give zstd time relative to gzip. zstd trims up to ${\sim }25\%$ of wall-clock time (relative time $0.75$--$0.98$) because compression, not search, is accelerated. RIsearch2 offers only gzip-style output, so the head-to-head comparisons in \cref  {fig:risearch-comparison} use gzip for both tools; with zstd, RIsearch's advantage over RIsearch2 widens further (quantified in the text above).}}{S5}{figure.4}\protected@file@percent }
\newlabel{fig:risearch-compression}{{S4}{S5}{\textbf {Output-compression modes within RIsearch}: zstd versus gzip (32 threads, extension 20\,nt). Numbers above bars give zstd time relative to gzip. zstd trims up to ${\sim }25\%$ of wall-clock time (relative time $0.75$--$0.98$) because compression, not search, is accelerated. RIsearch2 offers only gzip-style output, so the head-to-head comparisons in \cref {fig:risearch-comparison} use gzip for both tools; with zstd, RIsearch's advantage over RIsearch2 widens further (quantified in the text above)}{figure.4}{}}
\newlabel{fig:risearch-compression@cref}{{[figure][4][]S4}{[S1][1][]S5}}
